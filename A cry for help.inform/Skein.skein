  <item nodeId="node-0x56316c60e430">
    <command xml:space="preserve">x ghost</command>
    <result xml:space="preserve">Who do you mean, the ghost on the left of the plinth, the Ghost behind the plinth or the ghost on the right of the plinth?

&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <played>NO</played>
    <changed>NO</changed>
