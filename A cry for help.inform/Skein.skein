  <item nodeId="node-0x56316ccf92f0">
    <command xml:space="preserve">read note</command>
    <result xml:space="preserve">A crumpled piece of paper with frayed edges and smudged ink. It lists six numbers in two groups of three:

&quot;[2, 5, 2] [4, 7, 3]&quot;

&gt;</result>
