    </children>
  </item>
  <item nodeId="node-0x56316cef3340">
    <command xml:space="preserve">tell man abotu macaroni cheese</command>
    <result xml:space="preserve">I didn&apos;t understand that sentence.

&gt;</result>
    <commentary xml:space="preserve"></commentary>
