  <item nodeId="node-0x56316ccfc750">
    <command xml:space="preserve">unlock basket with note</command>
    <result xml:space="preserve">(the wicker basket with the crumpled note)
You unlock the wicker basket.

&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <played>NO</played>
    <changed>NO</changed>
    <temporary score="0">YES</temporary>
