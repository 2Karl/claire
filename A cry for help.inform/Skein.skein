  <item nodeId="node-0x56316cd23500">
    <command xml:space="preserve">look at dunes</command>
    <result xml:space="preserve">Like some sort of hot yellow ocean, the dunes undulate for miles all around you. Staring out at them, you suddenly feel thirsty.

&gt;</result>
