    </children>
  </item>
  <item nodeId="node-0x5598764be8d0">
    <command xml:space="preserve">open box</command>
    <result xml:space="preserve">You open the green box, revealing a green stone, a purple stone, an orange stone, a red stone, a blue stone, a mottled stone, a pink stone and a black stone.

&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <played>YES</played>
    <changed>NO</changed>
    <temporary score="0">YES</temporary>
    <annotation xml:space="preserve"></annotation>
