  <item nodeId="node-0x56316cf25620">
    <command xml:space="preserve">x bed</command>
    <result xml:space="preserve">A raised alcove contains a very comfortable looking bed. It looks easily big enough for two people. Or one person in a starfish configuration.

&gt;</result>
