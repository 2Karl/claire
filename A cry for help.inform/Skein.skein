    </children>
  </item>
  <item nodeId="node-0x56316cef9e30">
    <command xml:space="preserve">tell man about ophiuchus</command>
    <result xml:space="preserve">The old man&apos;s face turns serious, as if remembering something of great import. &quot;I remember now. I remember when we defeated the Servants of the Black Dawn. Seems so long ago now. What a wonderful night that was... But anyway, here&apos;s the knowledge you need: Page 87.&quot;

&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <played>NO</played>
    <changed>NO</changed>
    <temporary score="0">YES</temporary>
    <annotation xml:space="preserve"></annotation>
