  <item nodeId="node-0x56316cbdf3f0">
    <command xml:space="preserve">x sand</command>
    <result xml:space="preserve">The sand is rough and it&apos;s course and it gets everywhere. Seems like the sort of thing an edgelord would hate.

&gt;</result>
