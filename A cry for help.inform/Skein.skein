  <item nodeId="node-0x56316ce4a970">
    <command xml:space="preserve">x ruby</command>
    <result xml:space="preserve">fiery and captivating, the jagged red stone is a stone of nobility.

&gt;</result>
    <commentary xml:space="preserve"></commentary>
