      <child nodeId="node-0x5603b7a2d880"/>
    </children>
  </item>
  <item nodeId="node-0x5603b3d117d0">
    <command xml:space="preserve">look at birds</command>
    <result xml:space="preserve">Innumerable little birds, pale yellow with a beautiful golden crest, flit playfully through the mist. As you watch, they circle around you and then as one, fly through the swirling tendrils to the north. You feel compelled to follow.

&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <played>NO</played>
    <changed>YES</changed>
    <temporary score="0">YES</temporary>
    <annotation xml:space="preserve"></annotation>
