  <item nodeId="node-0x56316ce33c80">
    <command xml:space="preserve">identify black stone as obsidian</command>
    <result xml:space="preserve">You inspect the black stone closely...
You&apos;re absolutely certain the black stone is obsidian

&gt;</result>
