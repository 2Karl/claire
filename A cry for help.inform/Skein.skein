  <item nodeId="node-0x559878f71be0">
    <command xml:space="preserve">tell the old man about macaroni cheese</command>
    <result xml:space="preserve">&quot;Mmmmm macaroni cheese!&quot; The old man almost seems to salivate at the thought. &quot;Such a tasty dish. Why I remember the first time I made that for.... But I digress. Anyway here&apos;s your bit of knowledge in exchange: Page 75.&quot;

&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <played>YES</played>
    <changed>NO</changed>
    <temporary score="0">YES</temporary>
    <annotation xml:space="preserve"></annotation>
