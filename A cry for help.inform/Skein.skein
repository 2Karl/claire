  <item nodeId="node-0x56316cbba5a0">
    <command xml:space="preserve">x amethyst</command>
    <result xml:space="preserve">the smooth purple stone has been highly esteemed throughout the ages for its stunning beauty.

&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <played>NO</played>
    <changed>NO</changed>
    <temporary score="0">YES</temporary>
    <annotation xml:space="preserve"></annotation>
